{
  "name": "tauri-plugin-webview-guard-api",
  "version": "1.0.0",
  "description": "Frontend bindings for tauri-plugin-webview-guard, plus an ES5 floor probe for browser builds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaam-apps/tauri-webview-guard.git"
  },
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    ".": {
      "types": "./dist-js/index.d.ts",
      "import": "./dist-js/index.js",
      "require": "./dist-js/index.cjs"
    },
    "./probe/floor-probe.js": "./probe/floor-probe.js"
  },
  "files": [
    "dist-js",
    "probe",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "acorn": "^8.15.0",
    "jsdom": "^26.1.0",
    "rollup": "^4.34.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
